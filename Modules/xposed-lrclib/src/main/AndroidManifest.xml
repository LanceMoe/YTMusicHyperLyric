<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <queries>
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.android.systemui" />
    </queries>

    <application
        android:name="moe.lance.ytmusiclrc.ModuleApplication"
        android:allowBackup="false"
        android:label="YouTube Music HyperLyric"
        android:theme="@style/Theme.HyperLyric">

        <activity
            android:name="moe.lance.ytmusiclrc.ui.SettingsActivity"
            android:label="YouTube Music HyperLyric"
            android:exported="true" />

        <!-- Keep this entry enabled for LSPosed and the installer's Open button. -->
        <activity
            android:name="moe.lance.ytmusiclrc.ui.ModuleSettingsActivity"
            android:label="YouTube Music HyperLyric 设置"
            android:exported="true">
            <intent-filter>
                <!-- LSPosed resolves MAIN + MODULE_SETTINGS before trying the launcher. -->
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <!-- getLaunchIntentForPackage resolves INFO without a desktop icon. -->
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- Separate launcher entry lets the desktop icon be hidden without hiding LSPosed settings. -->
        <activity-alias
            android:name="moe.lance.ytmusiclrc.ui.SettingsLauncher"
            android:label="YouTube Music HyperLyric"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="moe.lance.ytmusiclrc.ui.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="moe.lance.ytmusiclrc.ui.LyricDetailActivity"
            android:label="歌词详情与编辑"
            android:exported="false" />

        <provider
            android:name="moe.lance.ytmusiclrc.cache.LyricsCacheProvider"
            android:authorities="moe.lance.ytmusiclrc.cache"
            android:exported="true" />
    </application>
</manifest>
